#!/usr/bin/env just --justfile

set fallback

sphinx_module := "sphinx"

# Format documentation source files
format:
    black conf.py
    mdformat .
    '{{ just_executable() }}' --fmt --unstable

# Build documentation.
build *args:
    python -m {{ sphinx_module }} --doctree-dir=_doctrees {{ args }} . _build

# Push documentation version
# the prefix "docs/" is dropped from version names
push *args:
    docput version push _build {{ args }}

# Update root files for the documentation site
update-root *args:
    docput upload --merge _root . {{ args }}
